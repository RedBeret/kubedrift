{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {"name": "parts-api", "namespace": "prod"},
  "spec": {
    "rules": [
      {
        "host": "parts.acme.example",
        "http": {
          "paths": [
            {
              "path": "/api",
              "pathType": "Prefix",
              "backend": {"service": {"name": "parts-api", "port": {"number": 80}}}
            },
            {
              "path": "/metrics",
              "pathType": "Prefix",
              "backend": {"service": {"name": "parts-api", "port": {"name": "metrics"}}}
            }
          ]
        }
      }
    ]
  }
}
