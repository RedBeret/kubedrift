{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {"name": "parts-api", "namespace": "prod"},
  "spec": {
    "type": "ClusterIP",
    "selector": {"app": "parts-api"},
    "ports": [
      {"name": "http", "port": 80, "targetPort": 8080, "protocol": "TCP"},
      {"name": "metrics", "port": 9090, "targetPort": "metrics"}
    ]
  }
}
